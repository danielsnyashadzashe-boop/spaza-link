MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="spazalink"

# Clerk (npx clerk@latest env pull writes these)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# Signs the integrity code on Financial Health Reports. 32+ random characters:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
REPORT_SIGNING_SECRET=""

# Optional: tolerate a drifting server clock (ms). Leave unset in production.
# CLERK_CLOCK_SKEW_MS=30000
